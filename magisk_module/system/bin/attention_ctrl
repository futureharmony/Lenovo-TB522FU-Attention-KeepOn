#!/system/bin/sh
##########################################################################################
# Lenovo Legion Y900 (TB522FU) Attention Keep-On Controller (WebUI backend)
# Author: futureharmony
#
# Subcommands:
#   on|off|toggle        master switch (config.json + secure keys -> app service reacts)
#   status               rich JSON status for the WebUI
#   set <key> <value>    update config.json (key-preserving) + push secure mirror
#                        keys: require_gaze gaze_grace_ms demand_mode demand_dwell_ms
#                              aon_evt_mask aon_algo aon_width aon_height aon_dps
#   test                 real single-shot detection: ensure stream, wait new EVT, restore
#   bind | unbind        point the framework (AttentionManagerService) at our service
#   log [n] / export / clear_log   combined logs (module + app + logcat) / save to Download
#
# ── 框架绑定（本模块的关键契约，2026-09-17 定案）────────────────────────────────
# ROM 的 AttentionManagerService 只从框架资源 config_defaultAttentionService 取
# provider（本 ROM = 自家 SystemUI 的 AONAttentionService），并且用
# PackageManager.MATCH_SYSTEM_ONLY 解析 —— 因此 (a) 普通安装的 APK 永远不合格，
# (b) secure setting attention_service_component 对本 ROM 无效（实测：写了也不读，
# 框架仍解析到 SystemUI）。而 shell 钩子 `cmd attention setTestableAttentionService
# <pkg>` 走的是另一条解析路径（GET_META_DATA，不做 system-only 过滤），所以普通 APK
# 可用。唯一硬性要求：服务必须在 manifest 里**声明**
# android:permission="android.permission.BIND_ATTENTION_SERVICE" —— 框架解析到候选后
# 会校验 ServiceInfo.permission 严格相等，否则 Slog.e 丢弃该服务（历史事故：服务永远
# 绑不上，框架静默回落到 SystemUI，表现就是"设置开关能开但盯着屏幕照样息屏"）。
# 该覆盖是 system_server 内存态，重启即失效 ⇒ 开机由 service.sh 绑定一次，
# supervisor.sh 周期性兜底重绑。
##########################################################################################

CONF_DIR="/data/adb/tb522fu_attention"
CONF_FILE="$CONF_DIR/config.json"
LOG_FILE="$CONF_DIR/attention.log"
MAX_LOG_LINES=800
AON_DIR="/data/data/futureharmony.tb522fu.aon/files"
CMD_FILE="$AON_DIR/aon_cmd"
EVT_FILE="$AON_DIR/aon_evt"
APP_PKG="futureharmony.tb522fu.aon"

mkdir -p "$CONF_DIR" 2>/dev/null

# 日志记录总开关（WebUI「记录」开关 / config.json log_enabled，默认 false）。
# 关闭时 log_message 直接跳过写入 —— 历史日志仍可 `log [n]` 查看、`clear_log` 清空。
# 安全关键行（post-fs-data ROLLBACK、supervisor FUSE）不走本函数，始终写入。
log_message() {
    local tag="$1"
    local msg="$2"
    if [ "$(json_get log_enabled false)" != "true" ]; then
        return 0
    fi
    echo "[$(date "+%Y-%m-%d %H:%M:%S")] [$tag] $msg" >> "$LOG_FILE"
    if [ -f "$LOG_FILE" ]; then
        local line_count=$(wc -l < "$LOG_FILE" 2>/dev/null || echo 0)
        if [ "$line_count" -gt "$MAX_LOG_LINES" ]; then
            tail -n 400 "$LOG_FILE" > "$CONF_DIR/attention_tmp.log" 2>/dev/null && \
                mv -f "$CONF_DIR/attention_tmp.log" "$LOG_FILE"
        fi
    fi
}

# ---------- config.json helpers (key-preserving; never rewrite the whole file) ----------

json_get() {  # json_get <key> [default]
    local v=$(sed -n 's/.*"'"$1"'"[[:space:]]*:[[:space:]]*\([^,}]*\).*/\1/p' "$CONF_FILE" 2>/dev/null | head -n1 | tr -d '"' | tr -d '\r')
    if [ -z "$v" ] || [ "$v" = "null" ]; then
        echo "$2"
    else
        echo "$v"
    fi
}

json_set() {  # json_set <key> <raw-value>
    local key="$1" val="$2"
    touch "$CONF_FILE" 2>/dev/null
    if grep -q "\"$key\"" "$CONF_FILE" 2>/dev/null; then
        sed -i 's/"'"$key"'"[[:space:]]*:[[:space:]]*[^,}]*/"'"$key"'": '"$val"'/' "$CONF_FILE" 2>/dev/null
    else
        # append into the JSON object
        sed -i 's/}$/,\n  "'"$key"'": '"$val"'\n}/' "$CONF_FILE" 2>/dev/null
    fi
    # sanity: if file is no longer valid-looking JSON (no braces), rebuild minimal
    if ! grep -q '{' "$CONF_FILE" 2>/dev/null; then
        echo "{\"$key\": $val}" > "$CONF_FILE"
    fi
}

get_config_enabled() {
    json_get enabled true
}

set_config_enabled() {
    json_set enabled "$1"
    json_set updated_at "\"$(date "+%Y-%m-%d %H:%M:%S")\""
}

# Push a partial JSON overlay into the secure mirror; the app's ContentObserver
# reloads it in real time (applySecure only overrides keys present in the blob).
push_mirror() {  # push_mirror <raw-json>
    settings put secure tb522fu_aon_config "$1" 2>/dev/null
}

uptime_ms() {
    awk '{printf "%.0f", $1 * 1000}' /proc/uptime 2>/dev/null
}

daemon_alive() {
    pidof aon_daemon.bin >/dev/null 2>&1 && echo true || echo false
}

# Last HBT registration state: st=0 unregistered, st=1 registered
# ⚠️ HBT 每 ~5 s 一条，而事件峰值可达 ~30/s ⇒ 「最后 20 行」在热流下常常一条 HBT 都没有，
#    会把**正在跑的流误判为停**（实测：空闲时 20 行里 20 条 HBT；热流时可能 0 条）。
#    故取**有界尾块** 8 KB（≈5~8 条 HBT）。另注意 HBT 最多滞后 5 s。
stream_registered() {
    [ -f "$EVT_FILE" ] || { echo 0; return; }
    local st=$(tail -c 8192 "$EVT_FILE" 2>/dev/null | grep '^HBT' | tail -n1 | sed 's/.*st=\([0-9]*\).*/\1/')
    echo "${st:-0}"
}

evt_size() { stat -c %s "$EVT_FILE" 2>/dev/null || echo 0; }
evt_count() { grep -c '^EVT' "$EVT_FILE" 2>/dev/null || echo 0; }

# 流是否真在**出事件**：<秒> s 内 aon_evt 是否新增了 EVT 行。
# ⚠️ 三条都不能用作判据：
#   ① HBT 的 st/rep —— 每 ~5 s 一条且有 ≤5 s 滞后；
#   ② 文件大小增量 —— **daemon 每 5 s 写一条 HBT 心跳，流没注册时文件照样在长**
#      （V2 实测：空闲态被误判为"在跑"，白等 20 s 才靠重试兜住）；
#   ③ EVT 行数的全文件 `grep -c` —— 能用但是 O(文件大小)。
# 这里只对「新增的那段字节」数 EVT 行（tail 会 seek，代价 O(增量)）。
evt_growing() {  # evt_growing <seconds>
    local s="${1:-2}" a b d
    a=$(evt_size)
    sleep "$s"
    b=$(evt_size)
    [ "$b" -le "$a" ] && { echo 0; return; }   # 没长 / 被重写(新会话) 都算"没在跑"
    d=$(tail -c +$((a + 1)) "$EVT_FILE" 2>/dev/null | grep -c '^EVT')
    [ "${d:-0}" -gt 0 ] && echo 1 || echo 0
}

battery_now_ua() {
    cat /sys/class/power_supply/battery/current_now 2>/dev/null | tr -d '\r\n'
}

sync_service() {
    am start-foreground-service -n $APP_PKG/.AONAttentionService >/dev/null 2>&1 || true
}

# Write a full start command from config params (daemon sscanf expects 7 fields).
cmd_start() {
    local mask=$(json_get aon_evt_mask 15)
    local algo=$(json_get aon_algo 2)
    local w=$(json_get aon_width 480)
    local h=$(json_get aon_height 360)
    local dps=$(json_get aon_dps 3)
    local seq=$(uptime_ms)
    seq=$((seq + 10))
    echo "state=start 0 1 $mask $algo $w $h $dps seq=$seq" > "$CMD_FILE" 2>/dev/null
}

cmd_stop() {
    local seq=$(uptime_ms)
    seq=$((seq + 10))
    echo "state=stop seq=$seq" > "$CMD_FILE" 2>/dev/null
}

# ----------------------------------------------- master switch --------------------------

cmd_on() {
    set_config_enabled true
    settings put secure adaptive_sleep 1 2>/dev/null
    settings put secure oplus_customize_smart_screen_off 1 2>/dev/null
    settings put system oplus_customize_smart_screen_off 1 2>/dev/null
    settings put secure tb522fu_aon_enabled 1 2>/dev/null
    # Demand Mode contract: AttentionManagerService only calls onCheckAttention on
    # the component registered here. The LSPosed hook may be inactive, so the root
    # side owns this write (same mechanism LwKy used, pointed at our service).
    settings put secure attention_service_component \
        "$APP_PKG/$APP_PKG.AONAttentionService" 2>/dev/null
    local pref_dir="/data/user/0/com.android.settings/shared_prefs"
    if [ -d "$pref_dir" ]; then
        echo "<?xml version='1.0' encoding='utf-8' standalone='yes' ?><map><boolean name=\"keep_on_looking\" value=\"true\" /></map>" > "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
        chmod 660 "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
        chown system:system "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
    fi
    sync_service
    log_message "STATUS" "开启注视不熄屏功能 (AON KeepOn Enabled)"
    echo "{\"success\":true,\"message\":\"注视不熄屏已开启\"}"
}

cmd_off() {
    set_config_enabled false
    settings put secure adaptive_sleep 0 2>/dev/null
    settings put secure oplus_customize_smart_screen_off 0 2>/dev/null
    settings put system oplus_customize_smart_screen_off 0 2>/dev/null
    settings put secure tb522fu_aon_enabled 0 2>/dev/null
    local pref_dir="/data/user/0/com.android.settings/shared_prefs"
    if [ -d "$pref_dir" ]; then
        echo "<?xml version='1.0' encoding='utf-8' standalone='yes' ?><map><boolean name=\"keep_on_looking\" value=\"false\" /></map>" > "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
        chmod 660 "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
        chown system:system "$pref_dir/keep_on_looking.xml" 2>/dev/null || true
    fi
    sync_service
    log_message "STATUS" "关闭注视不熄屏功能 (AON KeepOn Disabled)"
    echo "{\"success\":true,\"message\":\"注视不熄屏已关闭\"}"
}

# ------------------------------------------------ status --------------------------------

cmd_status() {
    local is_enabled=$(get_config_enabled)
    local asleep=$(settings get secure adaptive_sleep 2>/dev/null); [ -z "$asleep" ] && asleep=0
    local oplus_sec=$(settings get secure oplus_customize_smart_screen_off 2>/dev/null); [ -z "$oplus_sec" ] && oplus_sec=0
    local app_enabled=$(settings get secure tb522fu_aon_enabled 2>/dev/null)
    { [ -z "$app_enabled" ] || [ "$app_enabled" = "null" ]; } && app_enabled=$asleep

    local wake=$(dumpsys power 2>/dev/null | grep -m1 "mWakefulness=" | cut -d= -f2 | tr -d "\r"); [ -z "$wake" ] && wake="Unknown"
    local timeout_ms=$(dumpsys power 2>/dev/null | grep -m1 "mScreenOffTimeoutSetting=" | cut -d= -f2 | tr -d "\r"); [ -z "$timeout_ms" ] && timeout_ms=120000
    local svc_pid=$(pidof $APP_PKG:attention 2>/dev/null | awk '{print $1}')
    { [ -z "$svc_pid" ] || [ "$svc_pid" = "null" ]; } && svc_pid=$(pidof $APP_PKG 2>/dev/null | awk '{print $1}')
    local svc_running=false; [ -n "$svc_pid" ] && [ "$svc_pid" != "null" ] && svc_running=true
    local comp=$(settings get secure attention_service_component 2>/dev/null)
    [ "$comp" = "null" ] && comp=""

    # 框架真正解析到的 provider —— 这是能否收到 onCheckAttention 的唯一判据。
    # （secure setting attention_service_component 只是镜像，本 ROM 的
    #   AttentionManagerService 不读它，只认框架资源 + shell 测试钩子。）
    local bound=$(bound_component)
    local bound_ok=false
    case "$bound" in "$APP_PKG"/*) bound_ok=true ;; esac

    local daemon=$(daemon_alive)
    local st=$(stream_registered)
    local reg=$([ "$st" = "1" ] && echo true || echo false)
    local cur=$(battery_now_ua); [ -z "$cur" ] && cur=0

    # last EVT age in seconds
    local evt_age=-1
    if [ -f "$EVT_FILE" ]; then
        local last_ts=$(stat -c %Y "$EVT_FILE" 2>/dev/null)
        [ -n "$last_ts" ] && evt_age=$(( $(date +%s) - last_ts ))
    fi

    cat << EOF
{
  "success": true,
  "enabled": $is_enabled,
  "adaptive_sleep": $asleep,
  "oplus_smart_screen_off": $oplus_sec,
  "app_enabled": $app_enabled,
  "wakefulness": "$wake",
  "timeout_ms": $timeout_ms,
  "service_running": $svc_running,
  "service_pid": "$svc_pid",
  "component": "$comp",
  "attention_bound": $bound_ok,
  "attention_bound_component": "$bound",
  "daemon_alive": $daemon,
  "stream_registered": $reg,
  "stream_state": $st,
  "evt_age_s": $evt_age,
  "battery_current_ua": $cur,
  "require_gaze": $(json_get require_gaze true),
  "gaze_grace_ms": $(json_get gaze_grace_ms 800),
  "demand_mode": $(json_get demand_mode true),
  "demand_dwell_ms": $(json_get demand_dwell_ms 60000),
  "aon_evt_mask": $(json_get aon_evt_mask 15),
  "aon_algo": $(json_get aon_algo 2),
  "aon_width": $(json_get aon_width 480),
  "aon_height": $(json_get aon_height 360),
  "aon_dps": $(json_get aon_dps 3),
  "log_enabled": $(json_get log_enabled false),
  "hardware_sensor": "Camera 3 (OG0VE) Qualcomm AON FDPRO"
}
EOF
}

# ------------------------------------------------ set -----------------------------------

cmd_set() {
    local key="$1" val="$2"
    case "$key" in
        require_gaze|demand_mode)
            case "$val" in true|false) ;; *) echo "{\"success\":false,\"message\":\"$key 需为 true/false\"}"; exit 1;; esac
            json_set "$key" "$val"
            ;;
        log_enabled)
            case "$val" in true|false) ;; *) echo "{\"success\":false,\"message\":\"$key 需为 true/false\"}"; exit 1;; esac
            json_set "$key" "$val"
            # 联动 App 端文件日志（aon.log）：同一开关统一管控两端落盘量。
            # App 端 ContentObserver 收到 mirror 后 reload config，listener 重启 AonLog。
            json_set log_to_file "$val"
            push_mirror "{\"log_enabled\": $val, \"log_to_file\": $val}"
            log_message "SYSTEM" "logging $val (attention.log + app aon.log)"
            echo "{\"success\":true,\"message\":\"日志记录已$([ "$val" = "true" ] && echo 开启 || echo 关闭)\"}"
            exit 0
            ;;
        gaze_grace_ms|demand_dwell_ms|aon_evt_mask|aon_algo|aon_width|aon_height|aon_dps)
            case "$val" in ''|*[!0-9]*) echo "{\"success\":false,\"message\":\"$key 需为整数\"}"; exit 1;; esac
            # 数值范围硬校验：越界值直接拒绝，防止守护协议收到非法参数
            case "$key" in
                aon_evt_mask)    _lo=0;     _hi=15;;
                aon_algo)        _lo=1;     _hi=2;;
                aon_width)       _lo=160;   _hi=640;;
                aon_height)      _lo=120;   _hi=480;;
                aon_dps)         _lo=1;     _hi=30;;
                gaze_grace_ms)   _lo=0;     _hi=60000;;
                demand_dwell_ms) _lo=1000;  _hi=600000;;
            esac
            if [ "$val" -lt "$_lo" ] || [ "$val" -gt "$_hi" ]; then
                echo "{\"success\":false,\"message\":\"$key 超出合法范围 [$_lo, $_hi]\"}"
                exit 1
            fi
            json_set "$key" "$val"
            ;;
        *)
            echo "{\"success\":false,\"message\":\"未知配置项: $key\"}"
            exit 1
            ;;
    esac
    # mirror the changed key into the secure channel (app reloads live)
    push_mirror "{\"$key\": $val}"
    log_message "STATUS" "set $key=$val (config.json + secure mirror)"
    echo "{\"success\":true,\"message\":\"$key = $val 已应用\"}"
}

# ------------------------------------------- test ----------------------------------

# Real single-shot detection: make sure the daemon stream is registered, capture
# new EVT lines, judge mask bits, then restore the prior state.
#
# 判据演进（2026-09-17，实机复现假阴性后重写）：
#   ① 「文件大小增量」不能单独当判据 —— **daemon 启动会重写 aon_evt**
#      （实测冷 daemon 起来后 55804 B → 61 B、EVT 1534 → 0）。若窗口跨越一次 daemon
#      重启，`sz1 > sz0` 恒假 ⇒ 必然假报「无事件（流未出帧）」。现在发现 size 回落即
#      视为会话重启、基准归零（整份文件都是新写的）。
#   ② 8 s 窗口太短：常规冷启出帧仅 ~1~2 s，但 AON 客户端交接后首次 start 偶发不生效
#      （见 PITFALLS 24）。现为 20 s，且零帧时**重发一次 state=start** 再等 20 s。
#   ③ 「流是否已在跑」不再看 HBT 的 st（稀疏 + 滞后），改为 2 s 内 aon_evt 是否
#      **新增 EVT 行**（daemon 每 5 s 写 HBT 心跳 ⇒ 不能比文件大小）。
#   ④ 恢复语义：只在本函数**自己拉起**流时才 stop，避免误停框架/app 正在用的流。
#      ⚠️ 重试分支发了 start 就必须置 `started=1`，否则流会一直挂着不恢复。
cmd_test() {
    if [ "$(daemon_alive)" != "true" ]; then
        echo "{\"success\":false,\"code\":-1,\"resultName\":\"AON 守护进程未运行\",\"detail\":\"请重启模块或检查 service.sh\"}"
        exit 0
    fi

    local t0=$(uptime_ms)
    local prev_st=$(stream_registered)
    local started=0
    if [ "$(evt_growing 2)" != "1" ]; then
        cmd_start
        started=1
        log_message "TEST" "test: no EVT for 2s (hbt st=$prev_st) -> registering (state=start)"
    fi

    local found="" fallback="" attempts=0 i=0 sz0=0 sz1=0 delta=""
    local window=100   # 首轮 100 x 200ms = 20s，重试轮 50 x 200ms = 10s（总上限 ~32s）
    while [ "$attempts" -lt 2 ] && [ -z "$found" ]; do
        attempts=$((attempts + 1))
        [ "$attempts" -gt 1 ] && window=50
        sz0=$(evt_size)
        i=0
        while [ "$i" -lt "$window" ] && [ -z "$found" ]; do
            sleep 0.2
            sz1=$(evt_size)
            if [ "$sz1" -lt "$sz0" ]; then
                log_message "TEST" "test: aon_evt rewritten (${sz0} -> ${sz1}), re-baseline"
                sz0=0       # daemon 重写文件：整份内容都属新会话
            fi
            if [ "$sz1" -gt "$sz0" ]; then
                delta=$(tail -c +$((sz0 + 1)) "$EVT_FILE" 2>/dev/null)
                found=$(echo "$delta" | grep '^EVT b=1 ' | tail -n1)
                if [ -z "$found" ]; then
                    [ -z "$fallback" ] && fallback=$(echo "$delta" | grep '^EVT pres=0' | tail -n1)
                    sz0=$sz1   # 只见 STARTING / pres=0 之类，抬高基准继续等 b=1 帧
                fi
            fi
            i=$((i + 1))
        done
        if [ -z "$found" ] && [ "$attempts" -lt 2 ]; then
            cmd_start
            started=1       # ⚠️ 必须置位：否则重试拉起的流在收尾时不会被 stop（流会一直挂着）
            log_message "TEST" "test: no EVT after $((i * 200))ms (file EVT=$(evt_count)), retrying (state=start)"
        fi
    done
    [ -z "$found" ] && found="$fallback"

    local elapsed=$(( $(uptime_ms) - t0 ))
    local code=-1 name="无事件（流未出帧）" mask=0 gaze=false detail=""
    case "$found" in
        *"EVT b=1 "*)
            local vals=$(echo "$found" | sed 's/.*vals=//' | tr -d '\r')
            mask=$(echo "$vals" | cut -d, -f1)
            case "$mask" in ''|*[!0-9]*) mask=0 ;; esac
            gaze=false
            [ $((mask & 4)) -ne 0 ] && gaze=true
            if [ $((mask & 1)) -ne 0 ]; then
                code=1
                $gaze && name="PRESENT（注视屏幕）" || name="PRESENT（在场，未注视）"
            else
                code=0; name="ABSENT（未检测到人脸）"
            fi
            detail="mask=0x$(printf '%x' "$mask") vals=$vals"
            ;;
        *"EVT pres=0"*)
            code=0; name="ABSENT（未检测到人脸）"; detail="pres=0（会话起始标记）"
            ;;
    esac

    # Restore prior state: only stop the stream if *this test* was what started it
    # (demand mode keeps it down between framework checks).
    if [ "$started" = "1" ]; then
        cmd_stop
        log_message "TEST" "test: restoring stream down (state=stop)"
    fi
    log_message "TEST" "test result: code=$code $name elapsed=${elapsed}ms attempts=$attempts startedByTest=$started $detail"

    cat << EOF
{
  "success": true,
  "code": $code,
  "resultName": "$name",
  "elapsedMs": $elapsed,
  "mask": $mask,
  "gaze": $gaze,
  "attempts": $attempts,
  "startedByTest": $([ "$started" = "1" ] && echo true || echo false),
  "detail": "$detail",
  "action": "$([ $code = 1 ] && echo 检测到在场 / 注视 || echo 未检测到人脸)"
}
EOF
}

# ------------------------------------------------ log -----------------------------------

# 全量日志收集：模块脚本日志 + App 后台服务文件日志 + 服务进程 logcat。
# WebUI「运行日志」与 `export` 共用本函数。
unified_log() {
    local n="${1:-200}"
    local Y=$(date +%Y)
    local TAB=$(printf '\t')
    local tmp="$CONF_DIR/.unified.$$"
    : > "$tmp"

    # [模块] attention.log: "[2026-09-17 23:02:15] [TEST] msg"
    if [ -f "$LOG_FILE" ]; then
        tail -n "$n" "$LOG_FILE" 2>/dev/null | \
            sed -n "s/^\[\([0-9][0-9-]* [0-9:]*\)\] \(.*\)$/\1${TAB}模块${TAB}\2/p" >> "$tmp"
    fi

    # [服务] aon.log: "09-17 23:05:15.547 I/SVC: msg"（补年份参与排序）
    if [ -f "$AON_DIR/aon.log" ]; then
        tail -n "$n" "$AON_DIR/aon.log" 2>/dev/null | \
            sed -n "s/^\([0-9][0-9]-[0-9][0-9] [0-9:.]*\) \(.*\)$/$Y-\1${TAB}服务${TAB}\2/p" >> "$tmp"
    fi

    # [框架] logcat 中 Attention 相关行: "09-17 23:05:15.547 E AttentionManager: msg"
    # App 进程不写 logcat（其日志走 aon.log），本段采集框架侧的注视判定与息屏决策。
    logcat -d -t 3000 2>/dev/null | \
        grep -iE "attentionmanager|attentiondetector|checkAttention|adaptive_sleep|setTestableAttention" | \
        tail -n "$n" | \
        sed -n "s/^\([0-9][0-9]-[0-9][0-9] [0-9:.]*\) \(.*\)$/$Y-\1${TAB}框架${TAB}\2/p" >> "$tmp"

    # -t 指定制表符为唯一分隔符：field1 = 完整时间戳 key（含空格）。
    # toybox sort 默认把空格也当分隔符，会把 key 截断成纯日期导致排序失效。
    sort -s -t "$TAB" -k1,1 "$tmp" 2>/dev/null | tail -n "$n" | while IFS= read -r line; do
        [ -z "$line" ] && continue
        ts=${line%%"$TAB"*}
        rem=${line#*"$TAB"}
        src=${rem%%"$TAB"*}
        rest=${rem#*"$TAB"}
        echo "[$src] [$ts] $rest"
    done
    rm -f "$tmp"
}

cmd_log() {
    unified_log "${1:-200}"
}

cmd_export() {
    local ts=$(date "+%Y%m%d-%H%M%S")
    local dest_dir="/sdcard/Download"
    local dest="$dest_dir/AttentionKeepOn-log-$ts.log"
    local tmp="$CONF_DIR/export-$ts.tmp"
    {
        echo "# Lenovo Legion Y900 (TB522FU) Attention KeepOn 日志导出"
        echo "# 导出时间: $(date "+%Y-%m-%d %H:%M:%S")"
        echo "# 设备: $(getprop ro.product.model 2>/dev/null) / Android $(getprop ro.build.version.release 2>/dev/null)"
        echo "# 模块版本: $(grep '^version=' /data/adb/modules/tb522fu_attention_keepon/module.prop 2>/dev/null | cut -d= -f2)"
        echo "# 日志记录开关: $(json_get log_enabled false)（关闭状态下仅含历史日志；开启后才有持续新日志）"
        echo "# 来源前缀: [模块]=模块脚本  [服务]=App 后台服务  [框架]=系统框架 logcat"
        echo ""
        unified_log 400
    } > "$tmp" 2>/dev/null
    if [ ! -s "$tmp" ]; then
        rm -f "$tmp"
        echo "{\"success\":false,\"message\":\"日志内容为空，导出失败\"}"
        return 1
    fi
    mkdir -p "$dest_dir" 2>/dev/null
    if cp -f "$tmp" "$dest" 2>/dev/null && chmod 644 "$dest" 2>/dev/null; then
        rm -f "$tmp"
        echo "{\"success\":true,\"path\":\"$dest\",\"size\":$(wc -c < "$dest" 2>/dev/null || echo 0)}"
        return 0
    fi
    rm -f "$tmp"
    echo "{\"success\":false,\"message\":\"写入 $dest_dir 失败（存储不可用）\"}"
    return 1
}

cmd_clear_log() {
    # 三段日志全量清空：模块日志 + App 服务文件日志 + 系统 logcat 缓冲区
    > "$LOG_FILE" 2>/dev/null
    [ -f "$AON_DIR/aon.log" ] && > "$AON_DIR/aon.log" 2>/dev/null
    logcat -c 2>/dev/null || true
    log_message "SYSTEM" "日志已清空 (attention.log + aon.log + logcat)"
    echo "{\"success\":true,\"message\":\"日志已成功清空（含 App 服务日志与系统 logcat）\"}"
}

# ------------------------------- framework binding (AttentionService) -------------------

# 框架当前实际解析到的 provider 组件（空 = 没解析到 ⇒ 服务不可用 ⇒ 永不回调）
bound_component() {
    cmd attention getAttentionServiceComponent 2>/dev/null | head -n1 | tr -d '\r'
}

attention_is_bound() {
    case "$(bound_component)" in
        "$APP_PKG"/*) return 0 ;;
        *) return 1 ;;
    esac
}

cmd_bind() {
    if attention_is_bound; then
        echo "{\"success\":true,\"message\":\"框架已指向本服务\",\"component\":\"$(bound_component)\"}"
        return 0
    fi
    local before=$(bound_component)
    local out=$(cmd attention setTestableAttentionService "$APP_PKG" 2>&1 | head -n1 | tr -d '\r')
    sleep 1
    local comp=$(bound_component)
    if [ "$out" = "true" ] || [ -n "$comp" ]; then
        log_message "BIND" "framework attention provider: ${before:-<none>} -> $comp"
        echo "{\"success\":true,\"message\":\"框架已指向本服务\",\"component\":\"$comp\"}"
        return 0
    fi
    # 典型失败原因：APK 未声明 android:permission=BIND_ATTENTION_SERVICE，
    # 框架解析到候选后校验 ServiceInfo.permission 不等即 Slog.e 丢弃该服务。
    log_message "BIND" "FAILED (out=$out comp=${comp:-<none>}) - check BIND_ATTENTION_SERVICE in APK manifest"
    echo "{\"success\":false,\"message\":\"绑定失败: ${out:-no-output}（检查 APK 是否声明 BIND_ATTENTION_SERVICE）\",\"component\":\"$comp\"}"
    return 1
}

cmd_unbind() {
    cmd attention clearTestableAttentionService >/dev/null 2>&1 || true
    log_message "BIND" "testable override cleared -> ROM default provider"
    echo "{\"success\":true,\"message\":\"已解除测试绑定，回落 ROM 默认 provider\",\"component\":\"$(bound_component)\"}"
}

case "$1" in
    on)         cmd_on ;;
    off)        cmd_off ;;
    toggle)
        if [ "$(get_config_enabled)" = "true" ]; then cmd_off; else cmd_on; fi
        ;;
    status)     cmd_status ;;
    set)        cmd_set "$2" "$3" ;;
    test)       cmd_test ;;
    bind)       cmd_bind ;;
    unbind)     cmd_unbind ;;
    log)        cmd_log "$2" ;;
    export)     cmd_export ;;
    clear_log)  cmd_clear_log ;;
    daemon)     : ;;  # retired: screen sync is owned by the app service (Plan A)
    *)
        echo "Usage: attention_ctrl {on|off|toggle|status|set <key> <val>|test|bind|unbind|log [n]|export|clear_log}"
        exit 1
        ;;
esac
